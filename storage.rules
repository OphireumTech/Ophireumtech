rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && request.auth.token.role == 'super_admin';
    }

    function isStaff() {
      return isAuth() && (
        request.auth.token.role == 'super_admin' || 
        request.auth.token.role == 'license_admin' || 
        request.auth.token.role == 'finance_reviewer' || 
        request.auth.token.role == 'support_agent'
      );
    }

    // Protected EA Builds (Authenticated customers with active license or staff only)
    match /ea_builds/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // Customer Payment Receipts & Proofs
    match /payment_proofs/{userId}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == userId || isStaff());
      allow write: if isAuth() && request.auth.uid == userId && 
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Support Ticket Attachments
    match /ticket_attachments/{ticketId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth() && request.resource.size < 15 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
