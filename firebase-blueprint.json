{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account credential profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "support_agent", "finance_reviewer", "license_admin", "super_admin"] },
        "isEmailVerified": { "type": "boolean" },
        "mfaEnabled": { "type": "boolean" },
        "starterPurchased": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "LicensePlan": {
      "title": "LicensePlan",
      "description": "Commercial licensing plans with hard constraints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "priceUSDT": { "type": "number" },
        "validityDays": { "type": "number" },
        "riskSettingPct": { "type": "number" },
        "lotSetting": { "type": "number" },
        "suggestedEquityUSD": { "type": "string" },
        "signalsCount": { "type": "number" },
        "isTrial": { "type": "boolean" },
        "features": { "type": "array" }
      },
      "required": ["id", "name", "priceUSDT", "validityDays", "lotSetting"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "amountUSDT": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "under_review", "confirmed", "rejected", "refunded"] },
        "depositAddress": { "type": "string" },
        "txHash": { "type": "string" },
        "invoiceId": { "type": "string" },
        "licenseId": { "type": "string" },
        "createdAt": { "type": "string" },
        "confirmedAt": { "type": "string" }
      },
      "required": ["id", "userId", "planId", "amountUSDT", "status", "createdAt"]
    },
    "License": {
      "title": "License",
      "description": "Account-bound algorithmic software licence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "status": { "type": "string" },
        "validityDays": { "type": "number" },
        "riskSettingPct": { "type": "number" },
        "lotSetting": { "type": "number" },
        "boundMt5Account": { "type": "string" },
        "brokerName": { "type": "string" },
        "brokerServer": { "type": "string" },
        "accountType": { "type": "string" },
        "activatedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "isAutomationPaused": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "planId", "status", "createdAt"]
    },
    "UnbindingRequest": {
      "title": "UnbindingRequest",
      "description": "Request to unbind or transfer MT5 account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "currentLogin": { "type": "string" },
        "currentBroker": { "type": "string" },
        "reason": { "type": "string" },
        "newLogin": { "type": "string" },
        "newBroker": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedBy": { "type": "string" },
        "reviewNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "licenseId", "userId", "reason", "status", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer technical support inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "subject": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "category", "subject", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and state-transition logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorId": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "resourceType": { "type": "string" },
        "resourceId": { "type": "string" },
        "previousValue": { "type": "string" },
        "newValue": { "type": "string" },
        "reason": { "type": "string" },
        "ipAddress": { "type": "string" },
        "timestamp": { "type": "string" },
        "result": { "type": "string" }
      },
      "required": ["id", "actorId", "actorRole", "action", "resourceType", "timestamp", "result"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global operational and emergency settings",
      "type": "object",
      "properties": {
        "webrequestUrl": { "type": "string" },
        "approvedSymbols": { "type": "array" },
        "contactEmail": { "type": "string" },
        "supportWhatsApp": { "type": "string" },
        "mobileContact": { "type": "string" },
        "officialDomain": { "type": "string" },
        "usdtTrc20DepositAddress": { "type": "string" },
        "usdtErc20DepositAddress": { "type": "string" },
        "globalEmergencyStop": { "type": "boolean" },
        "globalStopReason": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "vpsAnnualPriceUSDT": { "type": "number" }
      },
      "required": ["webrequestUrl", "contactEmail", "globalEmergencyStop"]
    },
    "Mt5Binding": {
      "title": "Mt5Binding",
      "description": "Multi-state MT5 account binding with assigned Windows VPS worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "mt5Login": { "type": "string" },
        "brokerName": { "type": "string", "enum": ["FBS.com", "GTCFX.com", "Vantage Markets (Pty) Ltd", "Pepperstone Markets Limited"] },
        "brokerServer": { "type": "string" },
        "accountType": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_worker_validation", "active", "suspended", "unbound", "disconnected", "failed"] },
        "connectionState": { "type": "string", "enum": ["binding_infrastructure_pending", "connecting", "connected", "disconnected", "error"] },
        "credentialRefId": { "type": "string" },
        "workerId": { "type": "string" },
        "workerAssignedAt": { "type": "string" },
        "boundAt": { "type": "string" },
        "lastVerifiedAt": { "type": "string" },
        "lastSyncAt": { "type": "string" },
        "terminalLatencyMs": { "type": "number" },
        "terminalConnected": { "type": "boolean" },
        "executionHalted": { "type": "boolean" },
        "haltReason": { "type": "string" },
        "goldSymbolMapped": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["licenseId", "userId", "mt5Login", "brokerName", "brokerServer", "status", "connectionState"]
    },
    "Mt5Worker": {
      "title": "Mt5Worker",
      "description": "Authorized Windows VPS MT5 Terminal execution worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ipAddress": { "type": "string" },
        "region": { "type": "string" },
        "os": { "type": "string" },
        "terminalVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["online", "offline", "busy", "maintenance"] },
        "activeAccountsCount": { "type": "number" },
        "maxAccountsCapacity": { "type": "number" },
        "lastHeartbeatAt": { "type": "string" },
        "approvedBrokers": { "type": "array" }
      },
      "required": ["id", "name", "ipAddress", "status"]
    },
    "Mt5AccountSnapshot": {
      "title": "Mt5AccountSnapshot",
      "description": "Verified live MT5 account metrics from Windows VPS terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "mt5Login": { "type": "string" },
        "broker": { "type": "string" },
        "server": { "type": "string" },
        "currency": { "type": "string" },
        "balance": { "type": "number" },
        "equity": { "type": "number" },
        "margin": { "type": "number" },
        "freeMargin": { "type": "number" },
        "marginLevel": { "type": "number" },
        "leverage": { "type": "number" },
        "floatingProfit": { "type": "number" },
        "openPositionsCount": { "type": "number" },
        "activeOrdersCount": { "type": "number" },
        "pingMs": { "type": "number" },
        "terminalConnected": { "type": "boolean" },
        "tradingAllowed": { "type": "boolean" },
        "goldSymbolMapped": { "type": "string" },
        "snapshotTimestamp": { "type": "string" },
        "workerId": { "type": "string" }
      },
      "required": ["licenseId", "userId", "mt5Login", "balance", "equity", "snapshotTimestamp"]
    },
    "Mt5Position": {
      "title": "Mt5Position",
      "description": "Live open market position executed on MT5 terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "mt5Login": { "type": "string" },
        "ticket": { "type": "number" },
        "symbol": { "type": "string" },
        "type": { "type": "string" },
        "volume": { "type": "number" },
        "openPrice": { "type": "number" },
        "currentPrice": { "type": "number" },
        "sl": { "type": "number" },
        "tp": { "type": "number" },
        "profit": { "type": "number" },
        "openTime": { "type": "string" }
      },
      "required": ["licenseId", "ticket", "symbol", "type", "volume", "openPrice"]
    },
    "Mt5Order": {
      "title": "Mt5Order",
      "description": "Pending order on MT5 terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "ticket": { "type": "number" },
        "symbol": { "type": "string" },
        "type": { "type": "string" },
        "volume": { "type": "number" },
        "price": { "type": "number" },
        "state": { "type": "string" }
      },
      "required": ["licenseId", "ticket", "symbol", "type", "volume"]
    },
    "Mt5Deal": {
      "title": "Mt5Deal",
      "description": "Historical closed trade deal on MT5 terminal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "ticket": { "type": "number" },
        "symbol": { "type": "string" },
        "type": { "type": "string" },
        "volume": { "type": "number" },
        "price": { "type": "number" },
        "profit": { "type": "number" },
        "executedAt": { "type": "string" }
      },
      "required": ["licenseId", "ticket", "profit", "executedAt"]
    },
    "ExecutionRequest": {
      "title": "ExecutionRequest",
      "description": "Encrypted command queue item dispatched to Windows VPS worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "workerId": { "type": "string" },
        "command": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "in_progress", "completed", "failed"] },
        "attempts": { "type": "number" },
        "requestedAt": { "type": "string" }
      },
      "required": ["licenseId", "command", "status", "requestedAt"]
    },
    "ExecutionResult": {
      "title": "ExecutionResult",
      "description": "Execution result received from Windows VPS MT5 worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "licenseId": { "type": "string" },
        "workerId": { "type": "string" },
        "command": { "type": "string" },
        "success": { "type": "boolean" },
        "returnCode": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["requestId", "licenseId", "success", "timestamp"]
    },
    "AccountHeartbeat": {
      "title": "AccountHeartbeat",
      "description": "Worker to broker terminal ping and telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "mt5Login": { "type": "string" },
        "workerId": { "type": "string" },
        "status": { "type": "string" },
        "latencyMs": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["licenseId", "workerId", "status", "timestamp"]
    },
    "BrokerServer": {
      "title": "BrokerServer",
      "description": "Approved broker servers catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brokerName": { "type": "string" },
        "serverName": { "type": "string" },
        "isLive": { "type": "boolean" },
        "goldSymbol": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["brokerName", "serverName", "goldSymbol"]
    },
    "SymbolMapping": {
      "title": "SymbolMapping",
      "description": "Verified broker gold symbol specifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "brokerName": { "type": "string" },
        "standardSymbol": { "type": "string" },
        "brokerSymbol": { "type": "string" },
        "contractSize": { "type": "number" },
        "digits": { "type": "number" },
        "minLot": { "type": "number" },
        "maxLot": { "type": "number" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["brokerName", "standardSymbol", "brokerSymbol", "isVerified"]
    },
    "RiskPolicy": {
      "title": "RiskPolicy",
      "description": "Deterministic algorithmic trading safety policy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "planId": { "type": "string" },
        "maxLot": { "type": "number" },
        "riskPercent": { "type": "number" },
        "hardStopLossRequired": { "type": "boolean" },
        "maxDailyLossPct": { "type": "number" }
      },
      "required": ["planId", "maxLot", "hardStopLossRequired"]
    },
    "AutomationEvent": {
      "title": "AutomationEvent",
      "description": "Trading automation lifecycle events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "eventType": { "type": "string" },
        "severity": { "type": "string" },
        "details": { "type": "string" },
        "actor": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["licenseId", "eventType", "severity", "timestamp"]
    },
    "CredentialReference": {
      "title": "CredentialReference",
      "description": "GCP Secret Manager reference ID, never plaintext credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "mt5Login": { "type": "string" },
        "brokerServer": { "type": "string" },
        "secretManagerUri": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["licenseId", "secretManagerUri", "createdAt"]
    },
    "BindingAuditLog": {
      "title": "BindingAuditLog",
      "description": "Immutable security and audit log for MT5 binding events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "licenseId": { "type": "string" },
        "userId": { "type": "string" },
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "ipAddress": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["licenseId", "action", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "/plans/{planId}": {
      "schema": "LicensePlan",
      "description": "Authoritative commercial licensing packages"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/licenses/{licenseId}": {
      "schema": "License",
      "description": "Issued software licenses"
    },
    "/unbinding_requests/{requestId}": {
      "schema": "UnbindingRequest",
      "description": "MT5 account transfer requests"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Support tickets and communication threads"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable operational audit records"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Global infrastructure and emergency settings"
    },
    "/mt5Bindings/{bindingId}": {
      "schema": "Mt5Binding",
      "description": "Multi-state MT5 account binding records"
    },
    "/mt5Workers/{workerId}": {
      "schema": "Mt5Worker",
      "description": "Authorized Windows VPS MT5 execution workers"
    },
    "/mt5AccountSnapshots/{snapshotId}": {
      "schema": "Mt5AccountSnapshot",
      "description": "Live verified MT5 account metrics from worker"
    },
    "/mt5Positions/{positionId}": {
      "schema": "Mt5Position",
      "description": "Live open positions"
    },
    "/mt5Orders/{orderId}": {
      "schema": "Mt5Order",
      "description": "Active pending orders"
    },
    "/mt5Deals/{dealId}": {
      "schema": "Mt5Deal",
      "description": "Historical deals and execution reports"
    },
    "/executionRequests/{requestId}": {
      "schema": "ExecutionRequest",
      "description": "Encrypted command queue items for MT5 workers"
    },
    "/executionResults/{resultId}": {
      "schema": "ExecutionResult",
      "description": "Execution result responses from workers"
    },
    "/accountHeartbeats/{heartbeatId}": {
      "schema": "AccountHeartbeat",
      "description": "Terminal and worker latency heartbeats"
    },
    "/brokerServers/{serverId}": {
      "schema": "BrokerServer",
      "description": "Catalog of verified broker servers"
    },
    "/symbolMappings/{mappingId}": {
      "schema": "SymbolMapping",
      "description": "Approved XAUUSD gold symbol mappings"
    },
    "/riskPolicies/{policyId}": {
      "schema": "RiskPolicy",
      "description": "Algorithmic risk policies"
    },
    "/automationEvents/{eventId}": {
      "schema": "AutomationEvent",
      "description": "Execution halt and safety events"
    },
    "/credentialReferences/{credentialId}": {
      "schema": "CredentialReference",
      "description": "GCP Secret Manager reference ID, strictly internal"
    },
    "/bindingAuditLogs/{logId}": {
      "schema": "BindingAuditLog",
      "description": "Immutable MT5 binding audit records"
    }
  }
}
