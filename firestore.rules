rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Identity Helpers
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isAuth() && (
        request.auth.token.email_verified == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isEmailVerified == true)
      );
    }

    // Role detection: Priority 1: Auth Custom Claim. Priority 2: Firestore Document
    function getUserRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'visitor';
    }

    function hasRole(targetRole) {
      return isAuth() && (
        request.auth.token.role == targetRole ||
        getUserRole() == targetRole
      );
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isLicenseAdmin() {
      return isSuperAdmin() || hasRole('license_admin');
    }

    function isFinance() {
      return isSuperAdmin() || hasRole('finance_reviewer');
    }

    function isSupport() {
      return isSuperAdmin() || hasRole('support_agent');
    }

    function isStaff() {
      return isSuperAdmin() || isLicenseAdmin() || isFinance() || isSupport();
    }

    // 1. Users Collection
    // Customers can never elevate their own role or spoof email verification status
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && 
        request.resource.data.role == 'customer' &&
        (!('isEmailVerified' in request.resource.data) || request.resource.data.isEmailVerified == request.auth.token.email_verified);
      allow update: if isSuperAdmin() || (
        isOwner(userId) && 
        request.resource.data.role == resource.data.role &&
        (!('role' in request.resource.data.diff(resource.data).affectedKeys())) &&
        (!('isEmailVerified' in request.resource.data.diff(resource.data).affectedKeys()))
      );
      allow delete: if isSuperAdmin();
    }

    // 2. Profiles Collection
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 3. Plans Collection (Public Read, Super Admin Write)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 4. Orders Collection
    match /orders/{orderId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isFinance();
      allow create: if isAuth() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isFinance() || (
        isAuth() && 
        resource.data.userId == request.auth.uid && 
        (resource.data.status == 'pending' || resource.data.status == 'under_review') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['txHash', 'status', 'depositAddress', 'updatedAt']) &&
        (request.resource.data.status == 'pending' || request.resource.data.status == 'under_review')
      );
      allow delete: if isSuperAdmin();
    }

    // 5. Payments Collection
    match /payments/{paymentId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isFinance();
      allow write: if isFinance();
    }

    // 6. Licenses Collection
    // Customers cannot create licences, change validity/status, or issue to themselves.
    match /licenses/{licenseId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isLicenseAdmin();
      allow create: if isLicenseAdmin() || isFinance();
      allow update: if isLicenseAdmin() || (
        isAuth() && 
        resource.data.userId == request.auth.uid && 
        resource.data.status == 'ready_for_binding' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'boundMt5Account', 'brokerName', 'brokerServer', 'accountType', 'status', 'boundAt', 'updatedAt'
        ]) &&
        request.resource.data.status == 'active' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.expiresAt == resource.data.expiresAt
      );
      allow delete: if isSuperAdmin();
    }

    // 7. MT5 Unbinding Requests
    match /unbinding_requests/{requestId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isLicenseAdmin();
      allow create: if isAuth() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isLicenseAdmin();
      allow delete: if isSuperAdmin();
    }

    // 8. Support Tickets & Messages
    match /support_tickets/{ticketId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isStaff() || (
        isAuth() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'responses', 'customerLastSeen'])
      );
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if (isAuth() && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid) || isStaff();
        allow create: if isAuth();
      }
    }

    // 9. Invoices
    match /invoices/{invoiceId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isFinance();
      allow write: if isFinance();
    }

    // 10. VPS Instances
    match /vps_instances/{vpsId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow write: if isLicenseAdmin();
    }

    // 11. EA Versions & Builds
    match /ea_versions/{versionId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // 12. System Settings & Whitelists
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /approved_symbols/{symbolId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 13. Automation Controls
    match /automation_controls/{controlId} {
      allow read: if isLicenseAdmin();
      allow write: if isLicenseAdmin();
    }

    // 14. Notifications
    match /notifications/{notifId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || resource.data.userId == 'ALL');
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, delete: if isStaff();
    }

    // 15. Audit Logs (Append-only, strictly immutable, Super Admin read-only)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth();
      allow update, delete: if false; // Strict immutability
    }

    // 16. Heartbeats & Telemetry
    match /heartbeats/{hbId} {
      allow read: if isLicenseAdmin();
      allow write: if isAuth();
    }

    match /ea_validations/{valId} {
      allow read: if isLicenseAdmin();
      allow write: if isAuth();
    }

    // 17. MT5 Production Architecture Collections
    // A. Credential References: ZERO CLIENT ACCESS (Never exposed to browser or client SDK)
    match /credentialReferences/{credentialId} {
      allow read, write: if false;
    }

    // B. MT5 Bindings
    match /mt5Bindings/{bindingId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isLicenseAdmin();
      allow create: if isAuth() && 
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.brokerName in ['FBS.com', 'GTCFX.com', 'Vantage Markets (Pty) Ltd', 'Pepperstone Markets Limited']);
      allow update: if isLicenseAdmin() || (
        isAuth() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isSuperAdmin();
    }

    // C. MT5 Workers (Windows VPS Execution Workers)
    match /mt5Workers/{workerId} {
      allow read: if isAuth();
      allow write: if isLicenseAdmin();
    }

    // D. MT5 Account Snapshots (Verified worker snapshots, read-only for customer)
    match /mt5AccountSnapshots/{snapshotId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow write: if isLicenseAdmin();
    }

    // E. MT5 Live Positions, Orders, and Deals (Read-only for customer)
    match /mt5Positions/{positionId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow write: if isLicenseAdmin();
    }

    match /mt5Orders/{orderId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow write: if isLicenseAdmin();
    }

    match /mt5Deals/{dealId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow write: if isLicenseAdmin();
    }

    // F. Execution Requests (Encrypted command queue items)
    match /executionRequests/{requestId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isLicenseAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isLicenseAdmin();
      allow delete: if isSuperAdmin();
    }

    // G. Execution Results
    match /executionResults/{resultId} {
      allow read: if isAuth();
      allow write: if isLicenseAdmin();
    }

    // H. Account Heartbeats
    match /accountHeartbeats/{heartbeatId} {
      allow read: if isAuth();
      allow write: if isLicenseAdmin();
    }

    // I. Broker Servers & Symbol Mappings (Public read, Super Admin write)
    match /brokerServers/{serverId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /symbolMappings/{mappingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // J. Risk Policies
    match /riskPolicies/{policyId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // K. Automation Events
    match /automationEvents/{eventId} {
      allow read: if isAuth();
      allow write: if isLicenseAdmin();
    }

    // L. Binding Audit Logs (Strictly immutable, owner & super admin read)
    match /bindingAuditLogs/{logId} {
      allow read: if isSuperAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
