rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Identity Helpers
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'visitor';
    }

    function isSuperAdmin() {
      return isAuth() && (
        request.auth.token.role == 'super_admin' || 
        getUserRole() == 'super_admin' ||
        request.auth.token.email == 'dhenzecapital@gmail.com'
      );
    }

    function isLicenseAdmin() {
      return isAuth() && (
        isSuperAdmin() || 
        request.auth.token.role == 'license_admin' || 
        getUserRole() == 'license_admin'
      );
    }

    function isFinance() {
      return isAuth() && (
        isSuperAdmin() || 
        request.auth.token.role == 'finance_reviewer' || 
        getUserRole() == 'finance_reviewer'
      );
    }

    function isStaff() {
      return isAuth() && (
        isSuperAdmin() || 
        isLicenseAdmin() || 
        isFinance() || 
        request.auth.token.role == 'support_agent' || 
        getUserRole() == 'support_agent'
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // 2. Profiles Collection
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    // 3. Plans Collection (Public Read, Super Admin Write)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 4. Orders & Payments Collection
    match /orders/{orderId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isFinance();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isFinance() || (
        isAuth() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['txHash', 'status', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isFinance();
      allow write: if isFinance();
    }

    // 5. Licenses Collection
    match /licenses/{licenseId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isLicenseAdmin();
      allow create: if isLicenseAdmin() || isFinance();
      allow update: if isLicenseAdmin() || (
        isAuth() && 
        resource.data.userId == request.auth.uid && 
        (resource.data.status == 'ready_for_binding' || resource.data.status == 'unbinding_requested') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'boundMt5Account', 'brokerName', 'brokerServer', 'accountType', 'status', 'boundAt', 'updatedAt'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    // 6. MT5 Bindings & Unbinding Requests
    match /unbinding_requests/{requestId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isLicenseAdmin();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isLicenseAdmin();
      allow delete: if isSuperAdmin();
    }

    // 7. Support Tickets & Messages
    match /support_tickets/{ticketId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if (isAuth() && get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid) || isStaff();
        allow create: if isAuth();
      }
    }

    // 8. Invoices
    match /invoices/{invoiceId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isFinance();
      allow write: if isFinance();
    }

    // 9. VPS Instances
    match /vps_instances/{vpsId} {
      allow read: if (isAuth() && resource.data.userId == request.auth.uid) || isStaff();
      allow write: if isLicenseAdmin();
    }

    // 10. EA Versions & Builds
    match /ea_versions/{versionId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // 11. System Settings & Whitelists
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /approved_symbols/{symbolId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 12. Automation Controls
    match /automation_controls/{controlId} {
      allow read: if isLicenseAdmin();
      allow write: if isLicenseAdmin();
    }

    // 13. Notifications
    match /notifications/{notifId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || resource.data.userId == 'ALL');
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isStaff();
      allow delete: if isStaff();
    }

    // 14. Audit Logs (Append-only by authenticated users, immutable, read-only for Super Admin)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth();
      allow update, delete: if false; // Strict immutability
    }

    // 15. Heartbeats & Validations
    match /heartbeats/{hbId} {
      allow read: if isLicenseAdmin();
      allow write: if isAuth();
    }

    match /ea_validations/{valId} {
      allow read: if isLicenseAdmin();
      allow write: if isAuth();
    }

    // Default deny all other unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
